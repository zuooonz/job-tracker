# ---------------------------------------------------------------------------
# OpenAI 兼容模型（LLM_* 优先；兼容 DEEPSEEK_* 旧变量）
# ---------------------------------------------------------------------------
LLM_API_KEY=replace-with-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 留空时不发送 thinking 参数；由模型服务商决定默认行为
LLM_THINKING=
LLM_MAX_TOKENS=6000
# DEEPSEEK_API_KEY / BASE_URL / MODEL / THINKING / MAX_TOKENS 仍可作为兼容回退。

# ---------------------------------------------------------------------------
# 登录鉴权（服务器部署时由 deploy.py env init 生成；本地不设置则关闭鉴权）
# ---------------------------------------------------------------------------
# 登录密码：设置后所有 /api/* 需要登录（前端显示登录页）
TRACKER_LOGIN_PASSWORD=
# 令牌签名密钥：建议 32+ 位随机串；不设置时从密码派生（单用户够用）
TRACKER_AUTH_SECRET=
# 采集器/评价 worker 固定令牌（相当于应用密码），本机采集推送到服务器时使用
TRACKER_API_TOKEN=

# ---------------------------------------------------------------------------
# 服务器模式（本地开发不需要）
# ---------------------------------------------------------------------------
# 浏览器自动化模式：auto（默认）、headed 或 headless
BROWSER_MODE=auto
# 前端静态产物目录（frontend/dist）；设置后后端同端口托管前端
TRACKER_STATIC_DIR=
# 评价 worker 连接的后端地址（服务器上为 http://127.0.0.1:5175）
TRACKER_API_URL=http://127.0.0.1:5175

# ---------------------------------------------------------------------------
# 个人与服务器信息（只放本机 .env，仓库内不出现真实值）
# ---------------------------------------------------------------------------
# 服务器地址（deploy.py、评分 worker 使用）
TRACKER_SERVER_HOST=your-server.example.com
# 服务器上的前端/API 地址
TRACKER_SERVER_URL=http://your-server.example.com:5175
# BOSS 短信登录手机号（boss-login.js）
BOSS_LOGIN_PHONE=
# 岗位文件夹根目录与定制简历文件名前缀（sync_resumes.sh：<前缀>-*.pdf）
JOBS_ROOT=
RESUME_FILE_PREFIX=
