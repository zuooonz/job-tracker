[Unit]
Description=Job Tracker (FastAPI + static frontend)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/jobs-tracker/backend
EnvironmentFile=/opt/jobs-tracker/.env
ExecStart=/opt/jobs-tracker/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5175 --timeout-keep-alive 5 --timeout-graceful-shutdown 10
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
